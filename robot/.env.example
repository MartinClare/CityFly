NODE_ENV=development
APP_URL=http://localhost:3000
APP_SECRET=replace-with-a-random-32-char-app-secret
ENCRYPTION_SECRET=replace-with-a-random-32-char-enc-secret
AUTH_SECRET=replace-with-a-random-32-char-auth-secret

DATABASE_URL=postgresql://cityfly:cityfly@localhost:55432/cityfly
REDIS_URL=redis://localhost:56379

S3_ENDPOINT=http://localhost:59000
S3_REGION=us-east-1
S3_ACCESS_KEY=cityfly
S3_SECRET_KEY=cityflysecret
S3_BUCKET_RAW=cityfly-raw
S3_BUCKET_EXTRACTED=cityfly-extracted
S3_FORCE_PATH_STYLE=true

SEED_ADMIN_EMAIL=editor@example.com
SEED_ADMIN_PASSWORD=changeme-now

AI_PROVIDER=mock
LOG_LEVEL=info
TZ=UTC
DATA_RETENTION_DAYS=0
RATE_LIMIT_EXTERNAL_PER_MIN=60
FETCH_MAX_BYTES=5000000
FETCH_TIMEOUT_MS=15000
FETCH_BLOCK_PRIVATE_IPS=true
FETCH_ALLOW_HOSTS=localhost,127.0.0.1

# Optional — n8n routes return 503 until this is set (8+ chars)
N8N_API_TOKEN=
N8N_WEBHOOK_SECRET=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
PERPLEXITY_API_KEY=
GOOGLE_PSE_API_KEY=
GOOGLE_PSE_CX=
CADDY_DOMAIN=
# Review desk HTTPS (Caddy on HK ECS). Example: desk.cityfly.hk
# Point DNS A → ECS public IP, open SG 80/443, then: bash scripts/alibaba/setup-caddy.sh


# Phase 1 desk — copy real values from Data Feed / Grokbot; never commit .env
OPENROUTER_API_KEY=sk-or-v1-your-key-here
DEEPSEEK_MODEL=deepseek/deepseek-v4-pro-0813
KIE_API_KEY=
KIE_BASE_URL=https://api.kie.ai
KIE_IMAGE_MODEL=gpt-image-2-5-sunburst-text-to-image

# Review portal (required if DESK_BIND is public)
DESK_PASSWORD=
DESK_SECRET=
DESK_BIND=127.0.0.1
DESK_PORT=8787
