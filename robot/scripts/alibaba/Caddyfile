# City Sight review desk — reverse proxy
# desk.citysight.net → ECS. www may stay until magazine cutover to Vercel.

www.citysight.net, desk.citysight.net {
	encode gzip
	reverse_proxy 127.0.0.1:8787
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
	log {
		output file /var/log/caddy/cityfly-desk.log
	}
}
